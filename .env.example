# Go API the /api/* requests are proxied to (server-side only)
BACKEND_URL=http://localhost:8080

# Public URL of this site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chrome Web Store page of the extension
NEXT_PUBLIC_EXTENSION_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Seller details required by YooKassa, shown in the Russian footer and legal pages
# full name, e.g. Иванов Иван Иванович
NEXT_PUBLIC_SELLER_NAME=
# 12 digits
NEXT_PUBLIC_SELLER_INN=
# optional, default: самозанятый, плательщик НПД
NEXT_PUBLIC_SELLER_STATUS=
