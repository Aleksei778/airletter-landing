NEXT_PUBLIC_EXTENSION_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Seller details shown in legal pages (required by YooKassa / PayPal), e.g. "ИП Иванов И.И., ИНН 000000000000"
NEXT_PUBLIC_LEGAL_ENTITY=
